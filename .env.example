# ==============================================================================
# Cross-Document Fact Knowledge Layer - Environment Configuration
# ==============================================================================

# Groq Cloud API Key (Recommended for high-speed LLM extraction)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Optional Fallback LLM Providers
OPENAI_API_KEY=
GEMINI_API_KEY=

# Groq Rate Limiter Configuration (Default: 24 RPM, 2.5s pacing)
GROQ_RPM_LIMIT=24.0
GROQ_MIN_INTERVAL_SECONDS=2.5

# Server & UI Configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_SERVER_HEADLESS=true
